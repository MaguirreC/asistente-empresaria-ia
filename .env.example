# ==== AWS / Bedrock ====
# Región donde habilitaste los modelos (Latam suele usar us-east-1)
AWS_REGION=us-east-1

# Modelos de Claude en Bedrock. En Bedrock el ID lleva el prefijo "anthropic."
#   anthropic.claude-haiku-4-5  -> económico y rápido: preguntas frecuentes
#   anthropic.claude-sonnet-5   -> razonamiento: compra y casos complejos
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5

# Credenciales AWS: NO se ponen aquí en producción.
# En AWS el servicio usa un rol IAM. En local, `aws configure` o las variables
# estándar del SDK (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).

# ==== Backend de ventas (lo consultan las herramientas) ====
BACKEND_BASE_URL=https://pda1g4win0.execute-api.us-east-1.amazonaws.com/pro/api/v1/ventas-facilisimo

# Código de producto del chance tradicional, que exige /chance/loterias
CHANCE_CODE_PRODUCTO=2033

# ==== Servicio ====
# Orígenes permitidos para CORS (separados por coma). El front pondrá aquí su dominio.
CORS_ORIGINS=*

# Tope de tokens por respuesta. Un asistente de soporte responde corto;
# subir esto encarece cada mensaje.
MAX_TOKENS=2048

# Límite de mensajes por conversación, para frenar el uso como chat personal.
# En False mientras estamos probando; activar antes de producción.
LIMITE_MENSAJES_ACTIVO=False
LIMITE_MENSAJES_MAX=30
